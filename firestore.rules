rules_version = '2';

// ==========================================
// REGLAS DE SEGURIDAD DE FIRESTORE (§51, §53) — Etapa 8
// ==========================================
//
// Regla general (§53): el cliente puede LEER y PEDIR, nunca DECIDIR. Toda la
// entrega de valor (abrir/comprar/vender, Fichas, resultados) corre en Cloud
// Functions con el Admin SDK, que IGNORA estas reglas. Por eso acá casi todo es
// "solo lectura para el dueño": lo que da valor lo escribe el servidor.
//
// Se despliegan solas con `firebase deploy` (ver firebase.json → firestore.rules).
// También se pueden pegar a mano en la consola → Firestore Database → Reglas.

service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo global de solo lectura (§51, §54). Se poblará en la Etapa 8, para
    // que las Cloud Functions abran paquetes del lado del servidor. Cualquier
    // usuario autenticado puede leerlo; nadie lo escribe desde el cliente.
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Datos del usuario (§53). Desde la Etapa 8, el cliente puede LEER lo suyo
    // pero YA NO escribir nada que otorgue valor: colección, fichas, puntos e
    // inventario los escribe SOLO el Admin SDK (Cloud Functions), que ignora
    // estas reglas. Lo único que el cliente sigue escribiendo es su equipo
    // (formación / XI / mentalidades), que no da ventaja (§51.1).
    match /users/{userId} {
      function esDueno() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Documento de usuario (perfil + monedas + pity + inventario): solo lectura
      // para el dueño; lo escribe el servidor.
      allow read: if esDueno();
      allow write: if false;

      // Colección: solo lectura; la escribe el servidor al abrir/vender.
      match /collection/{playerId} {
        allow read: if esDueno();
        allow write: if false;
      }

      // Historial de partidos: solo lectura; lo escribe el servidor al registrar.
      match /historial/{matchId} {
        allow read: if esDueno();
        allow write: if false;
      }

      // Equipo (formación, XI, mentalidades): el dueño lo lee y lo escribe.
      match /teams/{teamId} {
        allow read, write: if esDueno();
      }
    }

    // Torneos y amistosos (Etapas 9–10): todavía no se usan. Bloqueados por
    // defecto hasta que existan sus reglas propias.
    match /torneos/{documento=**} {
      allow read, write: if false;
    }

    match /matches/{documento=**} {
      allow read, write: if false;
    }
  }
}
